  "item": [
    {
      "name": "List all users",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Проверка статус-кода\r",
              "pm.test(\"Status code is 200\", function () {\r",
              " pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Проверка, что ответ — массив\r",
              "pm.test(\"Response is an array\", function () {\r",
              " pm.expect(pm.response.json()).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "// 3. Проверка, что в массиве 10 пользователей\r",
              "pm.test(\"Array has 10 users\", function () {\r",
              " pm.expect(pm.response.json().length).to.eql(10);\r",
              "});\r",
              "\r",
              "// 4. Проверка, что у каждого пользователя есть обязательные поля\r",
              "pm.test(\"Each user has required fields\", function () {\r",
              " const users = pm.response.json();\r",
              " users.forEach(user => {\r",
              " pm.expect(user).to.have.all.keys(\"id\", \"name\", \"username\", \"email\");\r",
              " });\r",
              "});\r",
              "\r",
              "// 5. Проверка, что первый пользователь — это пользователь с id=1\r",
              "pm.test(\"First user has id = 1\", function () {\r",
              " pm.expect(pm.response.json()[0].id).to.eql(1);\r",
              "});\r",
              "\r",
              "// 6. Проверка времени ответа (не более 500 мс)\r",
              "pm.test(\"Response time is less than 500ms\", function () {\r",
              " pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get single user (id=3)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Проверка статуса\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Проверка, что ответ — объект, а не массив\r",
              "pm.test(\"Response is an object\", function () {\r",
              "pm.expect(pm.response.json()).to.be.an(\"object\");\r",
              "});\r",
              "\r",
              "// 3. Проверка, что id = 3\r",
              "pm.test(\"User id is 3\", function () {\r",
              "pm.expect(pm.response.json().id).to.eql(3);\r",
              "});\r",
              "\r",
              "// 4. Проверка, что у пользователя есть имя\r",
              "pm.test(\"User has name field\", function () {\r",
              "pm.expect(pm.response.json()).to.have.property(\"name\");\r",
              "});\r",
              "\r",
              "// 5. Проверка, что email содержит @\r",
              "pm.test(\"Email contains @\", function () {\r",
              "pm.expect(pm.response.json().email).to.include(\"@\");\r",
              "});\r",
              "\r",
              "// 6. Проверка структуры (наличие адреса)\r",
              "pm.test(\"User has address object\", function () {\r",
              "pm.expect(pm.response.json()).to.have.property(\"address\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
