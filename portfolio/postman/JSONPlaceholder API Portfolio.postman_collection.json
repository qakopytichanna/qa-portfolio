    {
      "name": "Get posts by userId",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Проверка статуса\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Проверка, что ответ — массив\r",
              "pm.test(\"Response is an array\", function () {\r",
              "pm.expect(pm.response.json()).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "// 3. Проверка, что все посты принадлежат userId=1\r",
              "pm.test(\"All posts belong to userId=1\", function () {\r",
              "const posts = pm.response.json();\r",
              "posts.forEach(post => {\r",
              "pm.expect(post.userId).to.eql(1);\r",
              "});\r",
              "});\r",
              "\r",
              "// 4. Проверка, что массив не пустой\r",
              "pm.test(\"Array is not empty\", function () {\r",
              "pm.expect(pm.response.json().length).to.be.greaterThan(0);\r",
              "});\r",
              "\r",
              "// 5. Проверка, что у каждого поста есть обязательные поля\r",
              "pm.test(\"Each post has required fields\", function () {\r",
              "const posts = pm.response.json();\r",
              "posts.forEach(post => {\r",
              "pm.expect(post).to.have.all.keys(\"userId\", \"id\", \"title\", \"body\");\r",
              "});\r",
              "});"
