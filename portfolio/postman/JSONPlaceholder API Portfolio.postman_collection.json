    {
      "name": "Update post fully",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Проверка статуса 200\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Проверка, что id не изменился\r",
              "pm.test(\"Id is still 1\", function () {\r",
              "pm.expect(pm.response.json().id).to.eql(1);\r",
              "});\r",
              "\r",
              "// 3. Проверка, что title обновился\r",
              "pm.test(\"Title was updated\", function () {\r",
              "const requestBody = JSON.parse(pm.request.body.raw);\r",
              "pm.expect(pm.response.json().title).to.eql(requestBody.title);\r",
              "});\r",
              "\r",
              "// 4. Проверка, что body обновился\r",
              "pm.test(\"Body was updated\", function () {\r",
              "const requestBody = JSON.parse(pm.request.body.raw);\r",
              "pm.expect(pm.response.json().body).to.eql(requestBody.body);\r",
              "});\r",
              "\r",
              "// 5. Проверка, что userId сохранился\r",
              "pm.test(\"UserId is still 1\", function () {\r",
              "pm.expect(pm.response.json().userId).to.eql(1);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
