    {
      "name": "Create new post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Проверка статуса 201 (Created)\r",
              "pm.test(\"Status code is 201 Created\", function () {\r",
              "pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "// 2. Проверка, что ответ — объект\r",
              "pm.test(\"Response is an object\", function () {\r",
              "pm.expect(pm.response.json()).to.be.an(\"object\");\r",
              "});\r",
              "\r",
              "// 3. Проверка, что сервер присвоил id\r",
              "pm.test(\"Response has id field\", function () {\r",
              "pm.expect(pm.response.json()).to.have.property(\"id\");\r",
              "});\r",
              "\r",
              "// 4. Проверка, что title совпадает с отправленным\r",
              "pm.test(\"Title matches request\", function () {\r",
              "const requestBody = JSON.parse(pm.request.body.raw);\r",
              "pm.expect(pm.response.json().title).to.eql(requestBody.title);\r",
              "});\r",
              "\r",
              "// 5. Проверка, что userId совпадает\r",
              "pm.test(\"UserId matches request\", function () {\r",
              "const requestBody = JSON.parse(pm.request.body.raw);\r",
              "pm.expect(pm.response.json().userId).to.eql(requestBody.userId);\r",
              "});\r",
              "\r",
              "// 6. Проверка, что тело поста не пустое\r",
              "pm.test(\"Body is not empty\", function () {\r",
              "pm.expect(pm.response.json().body).to.have.length.greaterThan(0);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"title\":\"Мой первый пост\",\r\n    \"body\": \"Этот текст моего первого поста для портфолио\",\r\n    \"userid\": 1\r\n}",
          "options": {
