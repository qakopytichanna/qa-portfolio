  "item": [
    {
      "name": "Create pet",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Проверка статус-кода\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Проверка формата ответа\r",
              "pm.test(\"Response is JSON\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "// Проверка ID\r",
              "pm.test(\"Pet has correct id\", function () {\r",
              "    pm.expect(pm.response.json().id).to.eql(777);\r",
              "});\r",
              "\r",
              "// Проверка имени\r",
              "pm.test(\"Pet has correct name\", function () {\r",
              "    pm.expect(pm.response.json().name).to.eql(\"Барсик\");\r",
              "});\r",
              "\r",
              "// Проверка статуса\r",
              "pm.test(\"Pet status is available\", function () {\r",
              "    pm.expect(pm.response.json().status).to.eql(\"available\");\r",
              "});\r",
              "\r",
              "// Сохраняем ID в переменную окружения\r",
              "pm.environment.set(\"pet_id\", pm.response.json().id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"id\": 777,\r\n  \"name\": \"Барсик\",\r\n  \"category\": {\r\n    \"id\": 1,\r\n    \"name\": \"cat\"\r\n  },\r\n  \"photoUrls\": [\"https://example.com/cat.jpg\"],\r\n  \"tags\": [\r\n    {\r\n      \"id\": 1,\r\n      \"name\": \"friendly\"\r\n    }\r\n  ],\r\n  \"status\": \"available\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/pet",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "pet"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Find pet by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Проверка статуса\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Проверка формата\r",
              "pm.test(\"Response is JSON\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "// Проверка ID совпадает\r",
              "pm.test(\"Pet id matches\", function () {\r",
              "    pm.expect(pm.response.json().id).to.eql(parseInt(pm.environment.get(\"pet_id\")));\r",
              "});\r",
              "\r",
              "// Проверка наличия поля name\r",
              "pm.test(\"Pet has name field\", function () {\r",
              "    pm.expect(pm.response.json()).to.have.property(\"name\");\r",
              "});\r",
              "\r",
              "// Проверка времени ответа\r",
              "pm.test(\"Response time < 500ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
