    {
      "name": "Find by status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Проверка статуса\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Проверка, что ответ — массив\r",
              "pm.test(\"Response is an array\", function () {\r",
              "pm.expect(pm.response.json()).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "// Проверка, что все питомцы имеют статус sold\r",
              "pm.test(\"All pets have status sold\", function () {\r",
              "var pets = pm.response.json();\r",
              "pets.forEach(function(pet) {\r",
              "pm.expect(pet.status).to.eql(\"sold\");\r",
              "});\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
